<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.surveyhelper.scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>surveyhelper-scan</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/rich/SurveyHelper</string>
