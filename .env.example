# surveyHelper configuration (copy to .env)

# Storage — dedicated pgvector Postgres (Insforge-swap-compatible)
SURVEYHELPER_DSN=postgresql://surveyhelper:surveyhelper@localhost:5544/surveyhelper

# Paper APIs (Phase 0-1 needs none of these; arXiv/S2/GitHub work unauthenticated)
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=

# Polite identification for arXiv / Crossref (best practice)
SURVEYHELPER_CONTACT_EMAIL=

# MCP server bind (HTTP, reachable from Dockerized OpenClaw via host.docker.internal)
SURVEYHELPER_MCP_HOST=0.0.0.0
SURVEYHELPER_MCP_PORT=8765

# Pipeline version stamp on analysis rows
SURVEYHELPER_PIPELINE_VERSION=card-v1
