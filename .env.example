# surveyHelper configuration (copy to .env)

# Storage — dedicated pgvector Postgres (Insforge-swap-compatible)
SURVEYHELPER_DSN=postgresql://surveyhelper:surveyhelper@localhost:5544/surveyhelper

# Paper APIs (Phase 0-1 needs none of these; arXiv/S2/GitHub work unauthenticated)
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=

# Polite identification for arXiv / Crossref (best practice)
SURVEYHELPER_CONTACT_EMAIL=

# MCP server bind (HTTP, reachable from Dockerized OpenClaw via host.docker.internal)
SURVEYHELPER_MCP_HOST=0.0.0.0
SURVEYHELPER_MCP_PORT=8765

# Pipeline version stamp on analysis rows
SURVEYHELPER_PIPELINE_VERSION=card-v1

# ── LLM backend ────────────────────────────────────────────────────────────
# anthropic (default) | openai | gemini | cli. "auto" picks the first provider whose
# key is set (anthropic → openai → gemini), else the OpenClaw `claude -p` subscription.
SURVEYHELPER_LLM_BACKEND=auto

# Set the key for whichever provider you use (just one is enough):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Anthropic model tiers (defaults shown). Flagship = synthesis; the rest are high-volume.
SURVEYHELPER_LLM_MODEL=claude-opus-4-8
SURVEYHELPER_LLM_SUMMARY_MODEL=claude-haiku-4-5
SURVEYHELPER_ANALYZE_MODEL=claude-haiku-4-5
SURVEYHELPER_VERIFY_MODEL=claude-haiku-4-5
# OpenAI / Gemini tiers (override to current IDs for your account). The pipeline's
# Claude model is mapped to the right tier automatically (cheap → summary, else flagship).
SURVEYHELPER_OPENAI_MODEL=gpt-5.5
SURVEYHELPER_OPENAI_SUMMARY_MODEL=gpt-5.4-mini
SURVEYHELPER_GEMINI_MODEL=gemini-3.5-flash
SURVEYHELPER_GEMINI_SUMMARY_MODEL=gemini-2.5-flash
# cli backend only: which OpenClaw container holds the authenticated `claude -p`.
SURVEYHELPER_OPENCLAW_CONTAINER=generalops-openclaw
